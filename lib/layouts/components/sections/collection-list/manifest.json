{
  "name": "collection-list",
  "type": "section",
  "styles": [
    "collection-list.css"
  ],
  "scripts": [],
  "requires": [
    "commons",
    "author-date",
    "collection-card",
    "collection-pagination"
  ],
  "context": [
    "collections"
  ],
  "requiredPlugins": [
    "metalsmith-sectioned-blog-pagination"
  ],
  "validation": {
    "required": [
      "sectionType",
      "collectionName"
    ],
    "properties": {
      "sectionType": {
        "type": "string",
        "const": "collection-list"
      },
      "collectionName": {
        "type": "string",
        "description": "Name of the collection to display (e.g., 'blog', 'components')"
      },
      "domainName": {
        "type": "string",
        "description": "URL segment the pagination links are built on (e.g., 'blog')"
      },
      "containerFields.inContainer": {
        "type": "boolean"
      },
      "containerFields.isAnimated": {
        "type": "boolean"
      },
      "containerFields.noMargin.top": {
        "type": "boolean"
      },
      "containerFields.noMargin.bottom": {
        "type": "boolean"
      },
      "containerFields.noPadding.top": {
        "type": "boolean"
      },
      "containerFields.noPadding.bottom": {
        "type": "boolean"
      }
    }
  },
  "fields": {
    "collectionName": {
      "widget": "select",
      "label": "Collection",
      "source": {
        "collections": true
      },
      "default": ""
    },
    "domainName": {
      "widget": "text",
      "label": "Pagination URL segment",
      "default": ""
    },
    "$extends": [
      "commons"
    ]
  }
}