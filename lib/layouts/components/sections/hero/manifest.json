{
  "name": "hero",
  "type": "section",
  "styles": [
    "hero.css"
  ],
  "scripts": [],
  "requires": [
    "ctas",
    "text",
    "image",
    "commons",
    "author-date"
  ],
  "validation": {
    "required": [
      "sectionType"
    ],
    "properties": {
      "sectionType": {
        "type": "string",
        "const": "hero"
      },
      "isReverse": {
        "type": "boolean"
      },
      "isFullScreen": {
        "type": "boolean"
      },
      "targetId": {
        "type": "string"
      },
      "isDisabled": {
        "type": "boolean"
      },
      "date": {
        "type": "string"
      },
      "containerFields.inContainer": {
        "type": "boolean"
      },
      "containerFields.isAnimated": {
        "type": "boolean"
      },
      "containerFields.noMargin.top": {
        "type": "boolean"
      },
      "containerFields.noMargin.bottom": {
        "type": "boolean"
      },
      "containerFields.noPadding.top": {
        "type": "boolean"
      },
      "containerFields.noPadding.bottom": {
        "type": "boolean"
      },
      "containerFields.background.isDark": {
        "type": "boolean"
      },
      "containerFields.background.imageScreen": {
        "type": "string",
        "enum": [
          "light",
          "dark",
          "none"
        ]
      },
      "text.titleTag": {
        "type": "string",
        "enum": [
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6"
        ],
        "default": "h1"
      },
      "ctas": {
        "type": "array",
        "items": {
          "properties": {
            "isButton": {
              "type": "boolean"
            },
            "buttonStyle": {
              "type": "string",
              "enum": [
                "primary",
                "secondary",
                "tertiary",
                "inverted"
              ]
            },
            "isSmall": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "fields": {
    "isReverse": {
      "widget": "checkbox",
      "label": "Reverse layout (text on the right)",
      "default": false
    },
    "isFullScreen": {
      "widget": "checkbox",
      "label": "Full-screen hero",
      "default": false
    },
    "targetId": {
      "widget": "text",
      "label": "Scroll target: id of the section the full-screen arrow scrolls to (defaults to first-section)",
      "default": ""
    },
    "date": {
      "widget": "text",
      "label": "Date (YYYY-MM-DD)",
      "default": ""
    },
    "author": {
      "widget": "multiselect",
      "label": "Authors",
      "source": {
        "data": "author",
        "valueKey": "name"
      },
      "default": []
    },
    "text": {
      "$use": "text",
      "titleTag": {
        "default": "h1"
      }
    },
    "image": {
      "$use": "image"
    },
    "ctas": {
      "$use": "ctas"
    },
    "$extends": [
      "commons"
    ]
  }
}